{
  "name": "artemisa-back",
  "version": "1.0.0",
  "description": "Platform for daycare management",
  "main": "index.js",
  "scripts": {
    "start": "node dist/Server.js",
    "dev": "ts-node-dev --transpile-only src/Server.ts",
    "build": "babel src --out-dir dist --extensions \".ts\" --copy-files",
    "db:migrate": "node dist/Config/Db.migrations.js",
    "db:migrate:dev": "ts-node src/Config/Db.migrations.ts",
    "db:seed": "node dist/Config/Db.seeds.js",
    "db:seed:dev": "ts-node src/Config/Db.seeds.ts",
    "test": "mocha -r ts-node/register -R dot src/**/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pho3niix/Artemisa-Back.git"
  },
  "keywords": [
    "artemisa",
    "node",
    "back",
    "daycare",
    "platform"
  ],
  "author": "Hugo Costilla",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pho3niix/Artemisa-Back/issues"
  },
  "homepage": "https://github.com/pho3niix/Artemisa-Back#readme",

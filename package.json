    "@babel/cli": "^7.16.7",
    "@babel/core": "^7.16.7",
    "@babel/node": "^7.16.7",
    "@babel/plugin-transform-runtime": "^7.16.8",
    "@babel/preset-env": "^7.16.7",
    "@babel/preset-typescript": "^7.16.7",
    "aws-sdk": "^2.740.0",
    "bcryptjs": "^2.4.3",
    "celebrate": "^11.0.1",
    "core-js": "^2.6.12",
    "cors": "^2.8.5",
    "crypto-js": "^4.0.0",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "express-async-handler": "^1.1.4",
    "express-fileupload": "^1.2.1",
    "handlebars": "^4.7.7",
    "helmet": "^3.21.2",
    "joi": "^17.4.0",
    "jsonwebtoken": "9.0.2",
    "mailcomposer": "^4.0.2",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.27",
    "morgan": "^1.9.1",
    "node-cron": "^3.0.0",
